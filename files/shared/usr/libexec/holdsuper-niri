#!/usr/bin/python3
"""Front end for the holdsuper daemon in niri, as hold-super@hadi.local is in GNOME.

Without a connected front end holdsuper leaves the mouse alone (pass mode), so in niri the
side button would never become Super. This one sends "pass 1" while a game is focused and
"pass 0" otherwise. Game rules as in the extension, without "any fullscreen window": app_id
steam_app_<n> or *.exe, a *.exe or `reaper SteamLaunch` among the process's ancestors, or an
app_id from the extension's game-classes. hold-ms and game-classes come from its GSettings.

While a game or a fullscreen-sized window is focused it also turns on warp-mouse-to-focus
(through ~/.config/niri/warp.kdl), so the pointer follows focus out of a game that hides it.
"""
import asyncio
import json
import os
import re
import subprocess

SOCK = os.path.join(os.environ["XDG_RUNTIME_DIR"], "holdsuper.sock")
WARP_FILE = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"),
                         "niri", "warp.kdl")
WARP_ON = 'input {\n    warp-mouse-to-focus mode="center-xy"\n}\n'
SCHEMA_DIR = "/usr/share/gnome-shell/extensions/hold-super@hadi.local/schemas"


def setting(key, default):
    try:
        out = subprocess.run(["gsettings", "--schemadir", SCHEMA_DIR, "get",
                              "org.gnome.shell.extensions.hold-super", key],
                             capture_output=True, text=True, timeout=5, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return default
    if key == "hold-ms":
        return int(out.split()[-1])
    return [c.lower() for c in re.findall(r"'([^']*)'", out)]


HOLD_MS = setting("hold-ms", 200)
GAME_CLASSES = setting("game-classes", [])


def process_is_game(pid):
    for _ in range(12):
        if pid <= 1:
            return False
        try:
            argv = open(f"/proc/{pid}/cmdline", "rb").read().decode(errors="replace").split("\0")
            stat = open(f"/proc/{pid}/stat").read()
        except OSError:
            return False
        if argv[0].lower().endswith(".exe") or "SteamLaunch" in argv:
            return True
        pid = int(stat[stat.rindex(")") + 2:].split()[1])
    return False


def is_game(win):
    app = (win.get("app_id") or "").lower()
    if re.fullmatch(r"steam_app_\d+", app) or app.endswith(".exe") or app in GAME_CLASSES:
        return True
    return bool(win.get("pid")) and process_is_game(win["pid"])


def output_sizes():
    try:
        out = subprocess.run(["niri", "msg", "--json", "outputs"],
                             capture_output=True, text=True, timeout=5, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return set()
    return {(o["logical"]["width"], o["logical"]["height"])
            for o in json.loads(out).values() if o.get("logical")}


class Warp:
    """niri reloads its config when warp.kdl changes, so the file is written only on a change."""

    def __init__(self):
        self.on = None
        self.set(False)

    def set(self, on):
        if on == self.on:
            return
        self.on = on
        tmp = WARP_FILE + ".tmp"
        try:
            with open(tmp, "w") as f:
                f.write(WARP_ON if on else "")
            os.replace(tmp, WARP_FILE)
        except OSError:
            self.on = None


class Daemon:
    """The holdsuper socket; reconnects when the daemon restarts (it never writes, so EOF = closed)."""

    def __init__(self):
        self.writer, self.passing = None, 0

    async def run(self):
        while True:
            try:
                reader, self.writer = await asyncio.open_unix_connection(SOCK)
                self.send(f"hold {HOLD_MS}\noverview 0\npass {self.passing}\n")
                await reader.read()
            except OSError:
                pass
            self.writer = None
            await asyncio.sleep(2)

    def send(self, text):
        if self.writer:
            self.writer.write(text.encode())

    def set_pass(self, passing):
        if passing != self.passing:
            self.passing = passing
            self.send(f"pass {passing}\n")


async def main():
    daemon = Daemon()
    asyncio.create_task(daemon.run())
    warp = Warp()
    sizes = output_sizes()
    windows, focused = {}, None
    proc = await asyncio.create_subprocess_exec("niri", "msg", "--json", "event-stream",
                                                stdout=asyncio.subprocess.PIPE)
    async for line in proc.stdout:
        ev = json.loads(line)
        if "WindowsChanged" in ev:
            windows = {w["id"]: w for w in ev["WindowsChanged"]["windows"]}
            focused = next((w["id"] for w in windows.values() if w["is_focused"]), None)
        elif "WindowOpenedOrChanged" in ev:
            w = ev["WindowOpenedOrChanged"]["window"]
            windows[w["id"]] = w
            if w["is_focused"]:
                focused = w["id"]
        elif "WindowClosed" in ev:
            windows.pop(ev["WindowClosed"]["id"], None)
        elif "WindowFocusChanged" in ev:
            focused = ev["WindowFocusChanged"]["id"]
        elif "WorkspacesChanged" in ev:
            sizes = output_sizes()
            continue
        else:
            continue
        win = windows.get(focused)
        game = bool(win) and is_game(win)
        daemon.set_pass(1 if game else 0)
        warp.set(game or bool(win) and tuple(win["layout"]["window_size"]) in sizes)
    raise SystemExit("niri event stream ended")


asyncio.run(main())
