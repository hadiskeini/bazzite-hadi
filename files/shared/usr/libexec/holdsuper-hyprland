#!/usr/bin/python3
"""Front end for the holdsuper daemon in Hyprland, as holdsuper-niri is in niri.

Sends "pass 1" while a game is focused and "pass 0" otherwise. Game rules as in holdsuper-niri:
class steam_app_<n> or *.exe, a *.exe or `reaper SteamLaunch` among the process's ancestors, or a
class from the extension's game-classes.
"""
import asyncio
import json
import os
import re
import subprocess

RUNTIME = os.environ["XDG_RUNTIME_DIR"]
SOCK = os.path.join(RUNTIME, "holdsuper.sock")
HYPR = os.path.join(RUNTIME, "hypr", os.environ["HYPRLAND_INSTANCE_SIGNATURE"])
SCHEMA_DIR = "/usr/share/gnome-shell/extensions/hold-super@hadi.local/schemas"


def setting(key, default):
    try:
        out = subprocess.run(["gsettings", "--schemadir", SCHEMA_DIR, "get",
                              "org.gnome.shell.extensions.hold-super", key],
                             capture_output=True, text=True, timeout=5, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return default
    if key == "hold-ms":
        return int(out.split()[-1])
    return [c.lower() for c in re.findall(r"'([^']*)'", out)]


HOLD_MS = setting("hold-ms", 200)
GAME_CLASSES = setting("game-classes", [])


def process_is_game(pid):
    for _ in range(12):
        if pid <= 1:
            return False
        try:
            argv = open(f"/proc/{pid}/cmdline", "rb").read().decode(errors="replace").split("\0")
            stat = open(f"/proc/{pid}/stat").read()
        except OSError:
            return False
        if argv[0].lower().endswith(".exe") or "SteamLaunch" in argv:
            return True
        pid = int(stat[stat.rindex(")") + 2:].split()[1])
    return False


async def active_window():
    reader, writer = await asyncio.open_unix_connection(os.path.join(HYPR, ".socket.sock"))
    writer.write(b"j/activewindow")
    data = await reader.read()
    writer.close()
    try:
        return json.loads(data or b"{}")
    except ValueError:
        return {}


def is_game(win):
    cls = (win.get("class") or "").lower()
    if re.fullmatch(r"steam_app_\d+", cls) or cls.endswith(".exe") or cls in GAME_CLASSES:
        return True
    return bool(win.get("pid")) and process_is_game(win["pid"])


class Daemon:
    """The holdsuper socket; reconnects when the daemon restarts (it never writes, so EOF = closed)."""

    def __init__(self):
        self.writer, self.passing = None, 0

    async def run(self):
        while True:
            try:
                reader, self.writer = await asyncio.open_unix_connection(SOCK)
                self.send(f"hold {HOLD_MS}\noverview 0\npass {self.passing}\n")
                await reader.read()
            except OSError:
                pass
            self.writer = None
            await asyncio.sleep(2)

    def send(self, text):
        if self.writer:
            self.writer.write(text.encode())

    def set_pass(self, passing):
        if passing != self.passing:
            self.passing = passing
            self.send(f"pass {passing}\n")


async def main():
    daemon = Daemon()
    asyncio.create_task(daemon.run())
    reader, _ = await asyncio.open_unix_connection(os.path.join(HYPR, ".socket2.sock"))
    async for line in reader:
        if line.startswith((b"activewindowv2>>", b"fullscreen>>", b"windowtitlev2>>")):
            daemon.set_pass(1 if is_game(await active_window()) else 0)
    raise SystemExit("Hyprland event socket closed")


asyncio.run(main())
