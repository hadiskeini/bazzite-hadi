#!/usr/bin/env bash
# Brave Origin launcher: feature flags have no policy (policies: /etc/brave/policies/managed). Exec path: files/scripts/brave-origin.sh.

# Brave writes web-app launchers with Exec from CHROME_WRAPPER, else from the raw binary, which skips the flags below.
export CHROME_WRAPPER=/usr/bin/brave-origin

dataDir="${XDG_CONFIG_HOME:-$HOME/.config}/BraveSoftware/Brave-Origin"
for arg in "$@"; do
  case "$arg" in --user-data-dir=*) dataDir="${arg#--user-data-dir=}" ;; esac
done

# A running Brave owns its profile: this call only hands the URL over, so change nothing.
lock="$(readlink "$dataDir/SingletonLock" 2>/dev/null)"
pid="${lock##*-}"
if [ "${lock%-*}" != "$HOSTNAME" ] || [ "$(readlink "/proc/$pid/exe" 2>/dev/null)" != "@BRAVE_DIR@/brave" ]; then
  # A reboot kills Brave before it writes exit_type "Normal"; "Crashed" shows the restore bubble and blocks session restore.
  for pref in "$dataDir"/*/Preferences; do
    grep -q '"exit_type":[[:space:]]*"Crashed"' "$pref" 2>/dev/null &&
      sed -i 's/"exit_type":[[:space:]]*"Crashed"/"exit_type":"Normal"/g' "$pref"
  done
  # Repair launchers written without CHROME_WRAPPER. Change only those: each write makes GNOME reload all apps.
  rawExec='^Exec=[^ ]*/opt/brave\.com/[^/ ]+/brave '
  for app in "$HOME"/.local/share/applications/brave-*.desktop; do
    grep -qE "$rawExec" "$app" 2>/dev/null && sed -i -E "s#$rawExec#Exec=$CHROME_WRAPPER #" "$app"
  done
fi

# Brave picks the keyring from the desktop name. It does not know "umbriel" and falls back to a fixed key,
# which cannot read the passwords and sync key stored under GNOME.
extra=()
[ "$XDG_CURRENT_DESKTOP" = umbriel ] && extra+=(--password-store=gnome-libsecret)

# HEVC/H.265 via VA-API on radeonsi (iOS screen recordings). VaapiVideoDecodeLinuxGL does not work for this.
exec "@BRAVE_DIR@/brave" \
  --enable-features=AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL \
  "${extra[@]}" "$@"
