# holdsuper's front end in niri (GNOME has the extension hold-super@hadi.local): without it the side button stays Forward only.
[Unit]
Description=holdsuper front end for niri (game detection, pass mode)
PartOf=niri.service
After=niri.service holdsuper.service
# Outside niri it fails and restarts every 2 s, and each start takes the holdsuper socket from the other front end.
ConditionEnvironment=NIRI_SOCKET

[Service]
ExecStart=/usr/libexec/holdsuper-niri
Restart=on-failure
RestartSec=2

[Install]
WantedBy=niri.service
