# holdsuper's front end in niri (GNOME has the extension hold-super@hadi.local): without it the side button stays Forward only.
[Unit]
Description=holdsuper front end for niri (game detection, pass mode)
PartOf=niri.service
After=niri.service holdsuper.service

[Service]
# Outside niri it would fail and restart every 2 s, and each start takes the holdsuper socket from the other
# front end. ExecCondition runs on every restart too; a [Unit] Condition did not stop the loop.
ExecCondition=/usr/bin/niri msg version
ExecStart=/usr/libexec/holdsuper-niri
Restart=on-failure
RestartSec=2

[Install]
WantedBy=niri.service
