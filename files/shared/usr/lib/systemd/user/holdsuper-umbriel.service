# Umbriel counterpart of the GNOME extension hold-super@hadi.local: drives holdsuper.service.
[Unit]
Description=holdsuper front end for Umbriel
PartOf=umbriel-session.target
After=umbriel-session.target holdsuper.service
# Second guard next to WantedBy: never in a GNOME session, even if something starts the unit by hand.
ConditionEnvironment=XDG_CURRENT_DESKTOP=umbriel

[Service]
ExecStart=/usr/libexec/holdsuper-umbriel
Restart=on-failure
RestartSec=2

[Install]
WantedBy=umbriel-session.target
