FROM registry.fedoraproject.org/fedora:45 AS build
ARG wf_config wayfire wf_shell wcm wayfire_plugins_extra
COPY build.sh /build.sh
COPY patches /patches
RUN wf_config=$wf_config wayfire=$wayfire wf_shell=$wf_shell wcm=$wcm wayfire_plugins_extra=$wayfire_plugins_extra \
    bash /build.sh

FROM scratch
COPY --from=build /out /out

LABEL org.opencontainers.image.source=https://github.com/hadiskeini/bazzite-hadi
