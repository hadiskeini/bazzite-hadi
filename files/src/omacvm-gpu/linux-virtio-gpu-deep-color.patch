From: OmacVM
Subject: [PATCH] drm/virtio: offer 10-bit scanout formats with virgl

With virgl the scanout is a host 3D resource, and the host can show any
format it can render to. Offer XRGB2101010, XBGR2101010, ARGB2101010 and
ABGR2101010 on the primary plane when virgl 3D is on, so a compositor can
scan out deep colour (Hyprland: bitdepth 10, needed for HDR output). The
2D path keeps XRGB8888 only. Only with the module option deep_color=1
(omacvm-virtio-gpu-load passes it for a start that asks for 10 bits):
without it the driver offers what the stock one does.

Upstream: could be sent (drm/virtio); not sent. The host must turn 10-bit
GL scanouts into deep-colour frames (OmacVM: qemu-cocoa-gl-present-color).
Test: modetest -p lists XR30 XB30 AR30 AB30 on the primary plane;
hyprctl monitors shows currentFormat XRGB2101010; QEMU logs "scanout
format 0x8059, half-float surfaces".
--- a/drivers/gpu/drm/virtio/virtgpu_display.c
+++ b/drivers/gpu/drm/virtio/virtgpu_display.c
@@ -321,12 +321,15 @@
 				   const struct drm_format_info *info,
 				   const struct drm_mode_fb_cmd2 *mode_cmd)
 {
+	struct virtio_gpu_device *vgdev = dev->dev_private;
 	struct drm_gem_object *obj = NULL;
 	struct virtio_gpu_framebuffer *virtio_gpu_fb;
 	int ret;
 
 	if (mode_cmd->pixel_format != DRM_FORMAT_HOST_XRGB8888 &&
-	    mode_cmd->pixel_format != DRM_FORMAT_HOST_ARGB8888)
+	    mode_cmd->pixel_format != DRM_FORMAT_HOST_ARGB8888 &&
+	    !(vgdev->has_virgl_3d && virtio_gpu_deep_color &&
+	      virtio_gpu_format_3d_only(mode_cmd->pixel_format)))
 		return ERR_PTR(-ENOENT);
 
 	/* lookup object associated with res handle */
--- a/drivers/gpu/drm/virtio/virtgpu_drv.h
+++ b/drivers/gpu/drm/virtio/virtgpu_drv.h
@@ -480,6 +480,8 @@
 
 /* virtgpu_plane.c */
 uint32_t virtio_gpu_translate_format(uint32_t drm_fourcc);
+bool virtio_gpu_format_3d_only(uint32_t drm_fourcc);
+extern bool virtio_gpu_deep_color;
 struct drm_plane *virtio_gpu_plane_init(struct virtio_gpu_device *vgdev,
 					enum drm_plane_type type,
 					int index);
--- a/drivers/gpu/drm/virtio/virtgpu_plane.c
+++ b/drivers/gpu/drm/virtio/virtgpu_plane.c
@@ -27,6 +27,7 @@
 #include <drm/drm_damage_helper.h>
 #include <drm/drm_fourcc.h>
 #include <drm/drm_gem_atomic_helper.h>
+#include <linux/moduleparam.h>
 #include <linux/virtio_dma_buf.h>
 #include <drm/drm_managed.h>
 #include <drm/drm_panic.h>
@@ -38,6 +39,40 @@
 	DRM_FORMAT_HOST_XRGB8888,
 };
 
+/*
+ * With virgl the scanout is a host 3D resource of any format the host can
+ * render to, so 10-bit buffers can be scanned out too (deep colour, HDR).
+ */
+static const uint32_t virtio_gpu_formats_3d[] = {
+	DRM_FORMAT_HOST_XRGB8888,
+	DRM_FORMAT_XRGB2101010,
+	DRM_FORMAT_XBGR2101010,
+	DRM_FORMAT_ARGB2101010,
+	DRM_FORMAT_ABGR2101010,
+};
+
+/*
+ * Offered only when asked: omacvm-virtio-gpu-load passes deep_color=1 for a
+ * start with the app's 10-bit switch on. Without it the driver offers what
+ * the stock one does.
+ */
+bool virtio_gpu_deep_color;
+module_param_named(deep_color, virtio_gpu_deep_color, bool, 0444);
+MODULE_PARM_DESC(deep_color, "Offer 10-bit scanout formats with virgl 3D (OmacVM)");
+
+bool virtio_gpu_format_3d_only(uint32_t drm_fourcc)
+{
+	switch (drm_fourcc) {
+	case DRM_FORMAT_XRGB2101010:
+	case DRM_FORMAT_XBGR2101010:
+	case DRM_FORMAT_ARGB2101010:
+	case DRM_FORMAT_ABGR2101010:
+		return true;
+	default:
+		return false;
+	}
+}
+
 static const uint32_t virtio_gpu_cursor_formats[] = {
 	DRM_FORMAT_HOST_ARGB8888,
 };
@@ -593,6 +628,10 @@
 		formats = virtio_gpu_cursor_formats;
 		nformats = ARRAY_SIZE(virtio_gpu_cursor_formats);
 		funcs = &virtio_gpu_cursor_helper_funcs;
+	} else if (vgdev->has_virgl_3d && virtio_gpu_deep_color) {
+		formats = virtio_gpu_formats_3d;
+		nformats = ARRAY_SIZE(virtio_gpu_formats_3d);
+		funcs = &virtio_gpu_primary_helper_funcs;
 	} else {
 		formats = virtio_gpu_formats;
 		nformats = ARRAY_SIZE(virtio_gpu_formats);
