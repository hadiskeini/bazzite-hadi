# pc-bazzite udev rules (image, host layer). Each block names the MIGRATION step that decided it.
#
# --- hidraw for browser/CLI configurators (MIGRATION 7.1: delete if Bazzite's rules already grant access at COLD boot)
#   3554 = Scyrox V8 dongle (scyrox.net + scyrox CLI/TUI), 19f5 = NuPhy Air75 V3 (drive.nuphy.io).
#   GROUP+MODE is the deterministic grant: uaccess ACLs are skipped for devices that enumerate before a session exists.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="3554", MODE="0660", GROUP="input", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="19f5", MODE="0660", GROUP="input", TAG+="uaccess"
#   scyroxd's virtual battery device sits under uhid with no USB parent, so idVendor does not match it, and
#   Bazzite's 92-viia.rules makes every other hidraw node 0666.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", KERNELS=="0003:3554:*", MODE="0660", GROUP="input"

# --- /dev/uhid for scyroxd running as a USER unit (decision 8): the daemon exposes the mouse battery as a virtual HID device
KERNEL=="uhid", SUBSYSTEM=="misc", MODE="0660", GROUP="input"

# --- package power for Mission Center: energy_uj is 0400 root by default (MIGRATION 7.4: delete if already readable)
SUBSYSTEM=="powercap", KERNEL=="intel-rapl*", RUN+="/usr/bin/chmod a+r /sys/%p/energy_uj"

# --- GPP0 spurious wake (Gigabyte BIOS). Root port 00:01.1 (the NM790 root disk) wakes the box ~6 s into every S3
#   suspend. Keyboard and mouse wake through XHC0 (00:08.1) and stay enabled.
ACTION=="add|change", SUBSYSTEM=="pci", KERNEL=="0000:00:01.1", ATTR{power/wakeup}="disabled"

# --- /dev/uinput for holdsuper (user unit) and the PyroFling latency layer (Mora, decision 9). Bazzite only tags it
#   uaccess, an ACL that appears when the session starts: a user unit that starts earlier gets EACCES. The uinput
#   group comes from sysusers.d/uinput.conf.
SUBSYSTEM=="misc", KERNEL=="uinput", MODE="0660", GROUP="uinput", OPTIONS+="static_node=uinput"

# --- The M32U monitor hub's USB Ethernet adapter (AX88179) is never used. Unauthorized: no driver, no NetworkManager
#   profile (its auto profile had IPv6 on), no traffic on the hub that also carries the EVO4.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="0b95", ATTR{idProduct}=="1790", ATTR{authorized}="0"
