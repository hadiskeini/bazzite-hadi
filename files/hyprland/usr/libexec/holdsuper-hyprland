#!/usr/bin/python3
"""Front end for the holdsuper daemon in Hyprland, as hold-super@hadi.local is in GNOME.

Without a connected front end holdsuper leaves the mouse alone, so the side button would never become Super.
This one sends "pass 1" while a game is focused and "pass 0" otherwise. Game rules as in the extension:
class steam_app_<n> or *.exe, a *.exe or `reaper SteamLaunch` among the process's ancestors, a class from the
extension's game-classes, or a fullscreen window (fullscreen-is-game). hold-ms, game-classes, fullscreen-is-game
and overview-on-release come from its GSettings, read when this service starts.

The window actions of the extension (hold + side or middle click) are off here: holdsuper sends Super+Q and
Super+F12 for them and drops the click, and Hyprland has no minimize for Super+F12. With them off the click goes
on with Super held, and hyprland.lua binds Super + side click (close the window below the pointer).

Focus and fullscreen changes come from Hyprland's event socket; layer-shell surfaces do not change the state.
"""
import asyncio
import json
import os
import re
import subprocess

RUNTIME = os.environ["XDG_RUNTIME_DIR"]
SOCK = os.path.join(RUNTIME, "holdsuper.sock")
HYPR = os.path.join(RUNTIME, "hypr", os.environ["HYPRLAND_INSTANCE_SIGNATURE"])
SCHEMA_DIR = "/usr/share/gnome-shell/extensions/hold-super@hadi.local/schemas"


def setting(key, default):
    try:
        out = subprocess.run(["gsettings", "--schemadir", SCHEMA_DIR, "get",
                              "org.gnome.shell.extensions.hold-super", key],
                             capture_output=True, text=True, timeout=5, check=True).stdout
    except (OSError, subprocess.SubprocessError):
        return default
    if key == "hold-ms":
        return int(out.split()[-1])
    if isinstance(default, bool):
        return out.strip() == "true"
    return [c.lower() for c in re.findall(r"'([^']*)'", out)]


HOLD_MS = setting("hold-ms", 200)
GAME_CLASSES = setting("game-classes", [])
FULLSCREEN_IS_GAME = setting("fullscreen-is-game", False)
OVERVIEW = setting("overview-on-release", True)
# Hyprland's fullscreen mode in j/activewindow; 1 is maximized.
FULLSCREEN = 2
# The active window's class and title changes come as activewindowv2 again.
RECHECK = (b"activewindowv2>>", b"fullscreen>>")


def process_is_game(pid):
    for _ in range(12):
        if pid <= 1:
            return False
        try:
            argv = open(f"/proc/{pid}/cmdline", "rb").read().decode(errors="replace").split("\0")
            stat = open(f"/proc/{pid}/stat").read()
        except OSError:
            return False
        if argv[0].lower().endswith(".exe") or "SteamLaunch" in argv:
            return True
        pid = int(stat[stat.rindex(")") + 2:].split()[1])
    return False


def is_game(window):
    app = (window.get("class") or "").lower()
    if re.fullmatch(r"steam_app_\d+", app) or app.endswith(".exe") or app in GAME_CLASSES:
        return True
    if FULLSCREEN_IS_GAME and (window.get("fullscreen") or 0) >= FULLSCREEN:
        return True
    return (window.get("pid") or 0) > 0 and process_is_game(window["pid"])


class Daemon:
    """The holdsuper socket; reconnects when the daemon restarts (it never writes, so EOF = closed)."""

    def __init__(self):
        self.writer, self.passing = None, 0

    async def run(self):
        while True:
            try:
                reader, self.writer = await asyncio.open_unix_connection(SOCK)
                self.send(f"hold {HOLD_MS}\noverview {int(OVERVIEW)}\ncombos 0\npass {self.passing}\n")
                await reader.read()
            except OSError:
                pass
            self.writer = None
            await asyncio.sleep(2)

    def send(self, text):
        if self.writer:
            self.writer.write(text.encode())

    def set_pass(self, passing):
        if passing != self.passing:
            self.passing = passing
            self.send(f"pass {passing}\n")


async def active_window():
    reader, writer = await asyncio.open_unix_connection(os.path.join(HYPR, ".socket.sock"))
    writer.write(b"j/activewindow")
    await writer.drain()
    reply = await reader.read()
    writer.close()
    try:
        return json.loads(reply) or None
    except ValueError:
        return None


async def main():
    daemon = Daemon()
    asyncio.create_task(daemon.run())
    events, _ = await asyncio.open_unix_connection(os.path.join(HYPR, ".socket2.sock"))
    while True:
        focused = await active_window()
        daemon.set_pass(1 if focused and is_game(focused) else 0)
        while not (line := await events.readline()).startswith(RECHECK):
            if not line:
                raise OSError("Hyprland closed the event socket")


try:
    asyncio.run(main())
except OSError as error:
    raise SystemExit(f"Hyprland IPC: {error}")
