#!/usr/bin/python3 -I
# COSMIC front end for the holdsuper daemon: the same job as the GNOME extension hold-super@hadi.local.
# It sends "hold"/"overview" from the extension's dconf settings, then "pass 1" while a game is focused
# and "pass 0" otherwise. Settings are read at start; restart the unit to apply changes.
# "combos 1": COSMIC has no mouse buttons in its shortcuts, so the daemon sends Super+F12 (minimize, a custom
# shortcut in the home repo) and Super+Q (close) for the middle and the other side button during a hold.
# The focused window comes from ext_foreign_toplevel_list_v1 and zcosmic_toplevel_info_v1, spoken on the wire:
# the image has no Wayland client library for Python.

import json
import os
import re
import select
import socket
import struct
import subprocess
import sys
import time

DCONF = "/org/gnome/shell/extensions/hold-super/"
SOCKET_PATH = os.path.join(os.environ["XDG_RUNTIME_DIR"], "holdsuper.sock")
ACTIVATED, FULLSCREEN = 2, 3
REGISTRY, CALLBACK = 2, 3
INTERFACES = {"ext_foreign_toplevel_list_v1": 1, "zcosmic_toplevel_info_v1": 2}  # name: version


def dconf(key, default):
    out = subprocess.run(["dconf", "read", DCONF + key], capture_output=True, text=True).stdout.strip()
    if not out:
        return default
    if out in ("true", "false"):
        return out == "true"
    if out.startswith("@as "):
        out = out[4:]
    return json.loads(out.replace("'", '"')) if out.startswith("[") else int(out)


HOLD_MS = dconf("hold-ms", 100)
OVERVIEW = dconf("overview-on-release", True)
FULLSCREEN_IS_GAME = dconf("fullscreen-is-game", False)
GAME_CLASSES = {c.strip().lower() for c in dconf("game-classes", [])}


def is_game(win):
    app = win["app_id"].lower()
    if re.fullmatch(r"steam_app_\d+", app) or app.endswith(".exe") or app in GAME_CLASSES:
        return True
    return FULLSCREEN_IS_GAME and FULLSCREEN in win["states"]


def string(text):
    data = text.encode() + b"\0"
    return struct.pack("I", len(data)) + data + b"\0" * (-len(data) % 4)


class Compositor:
    def __init__(self):
        display = os.environ.get("WAYLAND_DISPLAY", "wayland-0")
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.connect(os.path.join(os.environ["XDG_RUNTIME_DIR"], display))
        self.buf = b""
        self.next_id = CALLBACK + 1  # the compositor accepts new ids only in sequence
        self.list = self.info = None
        self.windows = {}  # ext handle id -> {"app_id", "states"}
        self.cosmic = {}   # cosmic handle id -> ext handle id
        self.send(1, 1, struct.pack("I", REGISTRY))
        self.send(1, 0, struct.pack("I", CALLBACK))

    def send(self, obj, opcode, body=b""):
        self.sock.sendall(struct.pack("IHH", obj, opcode, 8 + len(body)) + body)

    def read(self):
        chunk = self.sock.recv(1 << 16)
        if not chunk:
            sys.exit("the compositor closed the connection")
        self.buf += chunk
        while len(self.buf) >= 8:
            obj, opcode, size = struct.unpack("IHH", self.buf[:8])
            if len(self.buf) < size:
                break
            body, self.buf = self.buf[8:size], self.buf[size:]
            self.event(obj, opcode, body)

    def event(self, obj, opcode, body):
        if obj == 1 and opcode == 0:
            sys.exit("Wayland protocol error")
        elif obj == REGISTRY and opcode == 0:
            name, length = struct.unpack("II", body[:8])
            interface = body[8:8 + length - 1].decode()
            if interface in INTERFACES:
                self.send(REGISTRY, 0, struct.pack("I", name) + string(interface)
                          + struct.pack("II", INTERFACES[interface], self.next_id))
                if interface.startswith("ext"):
                    self.list = self.next_id
                else:
                    self.info = self.next_id
                self.next_id += 1
        elif obj == CALLBACK and None in (self.list, self.info):
            sys.exit("the compositor has no ext_foreign_toplevel_list_v1 or zcosmic_toplevel_info_v1")
        elif obj == self.list and opcode == 0:
            handle = struct.unpack("I", body)[0]
            self.windows[handle] = {"app_id": "", "states": set()}
            self.cosmic[self.next_id] = handle
            self.send(self.info, 1, struct.pack("II", self.next_id, handle))
            self.next_id += 1
        elif obj in self.windows and opcode == 0:
            del self.windows[obj]
            self.send(obj, 0)
        elif obj in self.windows and opcode == 3:
            length = struct.unpack("I", body[:4])[0]
            self.windows[obj]["app_id"] = body[4:4 + length - 1].decode(errors="replace")
        elif obj in self.cosmic and opcode == 8 and self.cosmic[obj] in self.windows:
            length = struct.unpack("I", body[:4])[0]
            self.windows[self.cosmic[obj]]["states"] = set(struct.unpack(f"{length // 4}I", body[4:4 + length]))

    def game_focused(self):
        focused = next((w for w in self.windows.values() if ACTIVATED in w["states"]), None)
        return int(focused is not None and is_game(focused))


def connect():
    while True:
        try:
            conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            conn.connect(SOCKET_PATH)
            conn.sendall(f"hold {HOLD_MS}\noverview {int(OVERVIEW)}\ncombos 1\n".encode())
            return conn
        except OSError:
            conn.close()
            time.sleep(2)


def main():
    compositor = Compositor()
    conn, sent = connect(), None
    while True:
        ready, _, _ = select.select([compositor.sock, conn], [], [])
        if compositor.sock in ready:
            compositor.read()
        # The daemon never writes: a readable socket means it closed (daemon restarted).
        if conn in ready:
            conn.close()
            conn, sent = connect(), None
        want = compositor.game_focused()
        if want != sent:
            try:
                conn.sendall(f"pass {want}\n".encode())
                sent = want
            except OSError:
                conn.close()
                conn, sent = connect(), None


if __name__ == "__main__":
    main()
