#!/usr/bin/bash
# GDM's Wayfire entries start this. The user manager outlives the session, so the session target must stop here,
# or graphical-session.target stays active into the next login.
trap 'systemctl --user stop wayfire-session.target' EXIT
trap 'exit 143' TERM HUP INT
# Right after the login screen, GDM's compositor can still hold the GPU: wlroots finds none and Wayfire exits at
# once (mutter waits for the device instead). An exit in the first seconds gets another try.
status=1
for try in 1 2 3 4; do
  start=$SECONDS
  wayfire "$@" &
  wait $! && exit 0
  status=$?
  (( SECONDS - start < 3 )) || exit "$status"
  sleep 1
done
exit "$status"
