# holdsuper's front end in Wayfire (GNOME has the extension hold-super@hadi.local): without it the side button stays Forward only.
[Unit]
Description=holdsuper front end for Wayfire (game detection, pass mode)
PartOf=wayfire-session.target
After=wayfire-session.target holdsuper.service
ConditionPathExists=/usr/bin/holdsuper

[Service]
ExecStart=/usr/libexec/holdsuper-wayfire
Restart=on-failure
RestartSec=2

[Install]
WantedBy=wayfire-session.target
