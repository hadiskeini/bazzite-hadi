[Unit]
Description=OmacVM: the "Mac" output has the Mac's volume and mute (both ways, through OmacVM Bridge)
PartOf=graphical-session.target
After=graphical-session.target pipewire-pulse.service
ConditionPathExists=%h/.config/omacvm-bridge/token
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/libexec/omacvm-mac-volume
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
