#!/usr/bin/python3
"""omacvm-mac-volume: the VM's "Mac" output (90-omacvm-mac-output.conf) has the Mac's volume and mute.

The output does not apply its volume; this agent passes it on, both ways:
  - the Mac's changes (OmacVM Bridge "audio" events: {"output": {"volume": 0-1, "muted"}}) are set on the output,
    so the desktop's own volume slider, bar icon and popup show them;
  - changes to the output (the desktop's slider, its volume keys, `wpctl`) go to the Mac (`omacvm-bridge volume`).
A change that only repeats the value the other side has is not sent back, so the two never chase each other.
"""
import json
import subprocess
import threading
import time

SINK = "omacvm_mac_output"
lock = threading.Lock()
mac = {"volume": None, "muted": None}   # what the Mac has, as last seen or set


def log(message):
    print(f"omacvm-mac-volume: {message}", flush=True)


def sink_state():
    try:
        vol = subprocess.run(["pactl", "get-sink-volume", SINK], capture_output=True, text=True, timeout=5).stdout
        mute = subprocess.run(["pactl", "get-sink-mute", SINK], capture_output=True, text=True, timeout=5).stdout
    except subprocess.TimeoutExpired:
        return None
    percents = [int(w.rstrip("%")) for w in vol.split() if w.endswith("%")]
    if not percents:
        return None
    return {"volume": round(sum(percents) / len(percents)), "muted": "yes" in mute}


def set_sink(volume, muted):
    subprocess.run(["pactl", "set-sink-volume", SINK, f"{volume}%"], timeout=5)
    subprocess.run(["pactl", "set-sink-mute", SINK, "1" if muted else "0"], timeout=5)


def from_mac():
    """The Mac's audio events into the output."""
    while True:
        proc = subprocess.Popen(["omacvm-bridge", "events"], stdout=subprocess.PIPE, text=True)
        for line in proc.stdout:
            if not line.startswith("data: "):
                continue
            try:
                out = json.loads(line[6:]).get("output")
            except ValueError:
                continue
            if not isinstance(out, dict) or not isinstance(out.get("volume"), (int, float)):
                continue
            volume, muted = round(out["volume"] * 100), out.get("muted") is True
            with lock:
                mac.update(volume=volume, muted=muted)
                state = sink_state()
                if state and (state["volume"] != volume or state["muted"] != muted):
                    set_sink(volume, muted)
        proc.wait()
        log("the Bridge's event stream ended; again in 3 s")
        time.sleep(3)


def to_mac():
    """Changes of the output to the Mac."""
    while True:
        proc = subprocess.Popen(["pactl", "subscribe"], stdout=subprocess.PIPE, text=True)
        for line in proc.stdout:
            if "on sink #" not in line or "'change'" not in line:
                continue
            with lock:
                state = sink_state()
                if not state or mac["volume"] is None:
                    continue
                if state["volume"] != mac["volume"]:
                    subprocess.run(["omacvm-bridge", "volume", str(state["volume"])], capture_output=True, timeout=10)
                    mac["volume"] = state["volume"]
                if state["muted"] != mac["muted"]:
                    subprocess.run(["omacvm-bridge", "mute", "on" if state["muted"] else "off"],
                                   capture_output=True, timeout=10)
                    mac["muted"] = state["muted"]
        proc.wait()
        log("pactl subscribe ended; again in 3 s")
        time.sleep(3)


threading.Thread(target=from_mac, daemon=True).start()
to_mac()
