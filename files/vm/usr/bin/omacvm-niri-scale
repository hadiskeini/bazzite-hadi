#!/usr/bin/env python3
"""omacvm-niri-scale: niri's scale per screen size, from the scales GNOME remembers.

With "Use external displays" off the VM has one output, and its size changes when the VM window moves between
the MacBook and an external display. GNOME (omacvm-integration, displays.js) stores the scale chosen per size
in ~/.local/state/omacvm/display-scales.json; this applies the stored scale in niri. niri has no output events,
so it checks every 2 s, and also puts the scale back after a config reload resets it. Sizes not in the file keep
niri's own scale. Started from the VM's host part of the niri config (~/home, hosts/vm-silverblue).
"""
import json
import os
import subprocess
import time

SCALES = os.path.expanduser("~/.local/state/omacvm/display-scales.json")


def scales():
    try:
        return json.load(open(SCALES))
    except (OSError, ValueError):
        return {}


def outputs():
    try:
        out = subprocess.run(["niri", "msg", "-j", "outputs"], capture_output=True, text=True, timeout=5)
        return json.loads(out.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return {}


while True:
    stored = scales()
    for name, o in outputs().items():
        if o.get("current_mode") is None or not o.get("logical"):
            continue
        mode = o["modes"][o["current_mode"]]
        want = stored.get(f"{mode['width']}x{mode['height']}")
        if want and abs(o["logical"]["scale"] - want) > 0.01:
            subprocess.run(["niri", "msg", "output", name, "scale", str(want)], capture_output=True)
    time.sleep(2)
